# ─── PRDS Environment Configuration ──────────────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ─── Application ──────────────────────────────────────────────────────────────
ENV=development        # development | production
PORT=8080

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_use_strong_password
DB_HOST=postgres
DB_PORT=5432
DB_USER=prds
DB_NAME=prds

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis:6379

# ─── Auth (REQUIRED — generate with: openssl rand -base64 64) ─────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MINIMUM_32_CHARS

# ─── GitHub OAuth (optional — get from github.com/settings/applications) ─────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/github/callback

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:80

# ─── Code Execution Sandbox ───────────────────────────────────────────────────
# Set to false if Docker socket not available
DOCKER_ENABLED=true

# ─── Monitoring (used with --profile monitoring) ──────────────────────────────
GRAFANA_PASSWORD=admin
